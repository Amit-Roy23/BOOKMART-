# ==============================================================================
# Bookmart Monorepo Root Environment Configuration
# ==============================================================================

# --- Network & Host IP Configuration ---
# Set this to your machine's local LAN IP (e.g. 192.168.1.102).
# This single variable configures ALLOWED_HOSTS, CORS, and the Next.js API endpoint.
HOST_IP=192.168.1.102

# --- Django Backend Configuration ---
DEBUG=True
SECRET_KEY=django-insecure-un1rt-o2r0+7q^xhut2mrv279pvzq)jjjxx$2&odrq&73u@77n
ALLOWED_HOSTS=127.0.0.1,localhost,backend,web,192.168.1.102
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.102:3000

# --- PostgreSQL Database ---
DB_NAME=bookmart_db
DB_USER=bookmart_user
DB_PASSWORD=bookmart_password
DB_HOST=postgres
DB_PORT=5432

# --- Next.js Web Frontend ---
NEXT_PUBLIC_API_URL=http://192.168.1.102:8000/api/v1

# --- Storage Settings ('local', 'cloudinary', 's3') ---
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# --- Email Credentials (for OTP delivery) ---
