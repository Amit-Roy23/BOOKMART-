# ==============================================================================
# Bookmart Mobile App - Development Environment Variables
# ==============================================================================
# IMPORTANT FOR LOCAL DEV ON PHYSICAL DEVICES (Expo Go):
# 1. Phone and computer must be connected to the SAME Wi-Fi network.
# 2. Run Expo with standard LAN mode: `npx expo start` (do NOT use --tunnel).
# 3. If your Wi-Fi changes, update the IP address below with your computer's LAN IPv4
#    (find it on Windows by running `ipconfig` in PowerShell/CMD under IPv4 Address).
# ==============================================================================
EXPO_PUBLIC_API_URL=http://192.168.1.106:8000/api/v1
API_URL=http://192.168.1.106:8000/api/v1

# Social Auth Credentials (Development)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-android-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-google-web-client-id.apps.googleusercontent.com
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id
