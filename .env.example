# ==============================================================================
# Bookmart Monorepo Root Environment Configuration Template
# ==============================================================================

# --- Network & Host IP Configuration ---
# Set this to your machine's local LAN IP (e.g. 192.168.1.102).
# Find your IP via `ipconfig` on Windows or `ipconfig getifaddr en0` on macOS.
# Update this single variable when switching Wi-Fi networks!
HOST_IP=192.168.1.102

# --- Django Backend Configuration ---
DEBUG=True
SECRET_KEY=django-insecure-un1rt-o2r0+7q^xhut2mrv279pvzq)jjjxx$2&odrq&73u@77n
ALLOWED_HOSTS=127.0.0.1,localhost,backend,web,192.168.1.102
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.102:3000

# --- PostgreSQL Database ---
DB_NAME=bookmart_db
DB_USER=bookmart_user
DB_PASSWORD=bookmart_password
DB_HOST=postgres
DB_PORT=5432

# --- Next.js Web Frontend ---
NEXT_PUBLIC_API_URL=http://192.168.1.102:8000/api/v1

# --- Storage Settings ('local', 'cloudinary', 's3') ---
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=us-east-1

# --- Email Credentials (for OTP delivery) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# --- Social Auth Credentials ---
GOOGLE_CLIENT_IDS=your_android_client_id,your_ios_client_id,your_web_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
