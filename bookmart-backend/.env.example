# ==============================================================================
# Bookmart Backend Environment Variables (Local Dev / Docker Template)
# ==============================================================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-un1rt-o2r0+7q^xhut2mrv279pvzq)jjjxx$2&odrq&73u@77n
ALLOWED_HOSTS=127.0.0.1,localhost,backend,web

# CORS Settings (Comma-separated origins for web frontend and mobile dev servers)
# In production, set to your real frontend domain(s), e.g. https://bookmart.vercel.app,https://bookmart.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# PostgreSQL Database (Local Dev / Docker)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bookmart_db
DB_USER=bookmart_user
DB_PASSWORD=bookmart_password
DB_HOST=postgres
DB_PORT=5432

# Production Database (Set DATABASE_URL on Render/Supabase)
# For Supabase Pooled Connection (Port 6543 / Supavisor):
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# DB_CONN_MAX_AGE=0
# DISABLE_SERVER_SIDE_CURSORS=True

# Redis & Celery Asynchronous Task Worker
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
# In production on Render/Upstash/Redis Labs, provide your connection URI:
# REDIS_URL=rediss://default:password@your-redis-host:6379/0

# SMTP Email Configuration (for OTP delivery)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Media Storage Provider (options: 'local', 'cloudinary', 's3')
# In production on Render/PaaS, set to 'cloudinary' or 's3' (local disks are ephemeral and wiped on restart)
STORAGE_PROVIDER=local

# Cloudinary Settings (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AWS S3 / Supabase Storage Settings (if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=us-east-1
# AWS_S3_CUSTOM_DOMAIN=cdn.yourdomain.com
# For Supabase Storage (S3-compatible):
# AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3

# Social Authentication
GOOGLE_CLIENT_IDS=your_android_client_id,your_ios_client_id,your_web_client_id
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Sentry Error Tracking & Performance Monitoring (Leave empty in local dev)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
